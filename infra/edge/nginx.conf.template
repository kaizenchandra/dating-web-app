# Place behind TLS termination on a private network, or add reviewed TLS listeners.
# The immediate peer is the client; arbitrary X-Forwarded-For is never trusted.
server {
    listen 8080;
    server_name _;
    access_log off;
    server_tokens off;
    client_max_body_size 7m;
    location = /api/v1/socket {
        proxy_pass http://gateway:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 75s;
    }
    location / {
        proxy_pass http://web:3000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Raahi-Edge-Token "${EDGE_PROXY_TOKEN}";
        proxy_set_header X-Raahi-Client-Address $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Web-Proxy-Token "";
        proxy_set_header X-Client-Address "";
    }
}
