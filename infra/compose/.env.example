APP_ENV=local
DB_PASSWORD=replace-with-random-secret
OTP_PEPPER=replace-with-random-secret
WEB_ORIGIN=http://localhost:3000
# Local only. Set disabled in deployed environments; local delivery then cannot start.
LOCAL_TEST_DELIVERY=enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
SMS_ADAPTER_URL=
SMS_ADAPTER_TOKEN=
S3_SECRET_KEY=replace-with-random-secret
# Go profile service uses S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY and S3_TLS.
# Local Compose supplies endpoint/username; production must use TLS and restricted credentials.

# Provider test credentials; never use live keys in local mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
MFA_ENCRYPTION_KEY=
WEBRTC_ICE_SERVERS=[]
# Coturn REST credentials: secret stays server-side, browser credentials expire.
TURN_URLS=[]
TURN_SHARED_SECRET=
WEBRTC_RELAY_ONLY=false

# Separate receiver credentials; local:env generates them. Never expose to browsers.
IDENTITY_SERVICE_TOKEN=replace-with-random-secret
COMMUNICATION_SERVICE_TOKEN=replace-with-random-secret
COMMERCE_OPERATIONS_SERVICE_TOKEN=replace-with-random-secret
PROFILE_DISCOVERY_SERVICE_TOKEN=replace-with-random-secret
CONNECTIONS_SERVICE_TOKEN=replace-with-random-secret
GATEWAY_SERVICE_TOKEN=replace-with-random-secret
WEB_PROXY_TOKEN=replace-with-random-secret

# Dedicated edge credential, shared only with the TLS proxy and Next server.
EDGE_PROXY_TOKEN=replace-with-random-secret

# Monthly tier amounts (INR); matching Razorpay monthly plans required for auto-renewal.
RAZORPAY_GOLD_PLAN_ID=
RAZORPAY_DIAMOND_PLAN_ID=
RAZORPAY_PLATINUM_PLAN_ID=
PREMIUM_GOLD_INR=499
PREMIUM_DIAMOND_INR=999
PREMIUM_PLATINUM_INR=1499
