{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:raahi:event:v1",
  "title": "Durable connection.matched event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "type",
    "aggregateId",
    "aggregateVersion",
    "occurredAt",
    "correlationId",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "const": 1
    },
    "type": {
      "const": "connection.matched"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matchId",
        "firstAccountId",
        "secondAccountId"
      ],
      "properties": {
        "matchId": {
          "type": "string",
          "format": "uuid"
        },
        "firstAccountId": {
          "type": "string",
          "format": "uuid"
        },
        "secondAccountId": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
